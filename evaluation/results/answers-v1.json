      "page_hit": true,
      "answer": {
        "status": "answered",
        "answer": "Immutability prevents surprising changes that can occur when multiple parts of a program hold references to the same mutable value. Because an immutable value cannot be updated in place, any new value created by a function is a distinct object; the original value remains unchanged. This guarantees that sharing a reference does not lead to hidden side\u2011effects, making the program\u2019s behavior predictable and referentially transparent.",
        "citations": [
          {
            "source_id": "b00fac9bc619a506883d463e879dc869",
            "document_id": "sample-Lecture-1-Pure-Functions",
            "filename": "Lecture-1-Pure-Functions.pdf",
            "page": 2,
            "quote": "An immutable value is not updated in place. Binding a new name or constructing a new list does not change the original value. This avoids surprising changes through shared references."
          }
        ]
      },
